+std::vector<size_t> llama_moe_stream::slab_sizes() const {
+    std::vector<size_t> out;
+    for (const auto & sl : layers) {
+        if (!sl) {
+            continue;
+        }
+        for (const auto & wt : sl->weights) {
+            if (std::find(out.begin(), out.end(), wt.nb_expert) == out.end()) {
+                out.push_back(wt.nb_expert);
+            }
+        }
+        break; // every streamed layer has the same weight shapes
+    }
+    return out;
+}
