+// A streamed slab can be uploaded straight from the mapped file, which skips the kernel copy a
+// buffered read makes into staging. The offsets come from the loader, so compare one slab read
+// both ways before trusting them - a wrong mapping would quietly upload wrong weights.
+void llama_moe_stream::set_mappings(const llama_mmaps & mappings) {
+#ifndef _WIN32
+    // only Windows keeps the whole view mapped; elsewhere the loader really unmaps the fragments
+    // it did not load, and the streamed experts are among them
+    GGML_UNUSED(mappings);
+    return;
+#else
+    if (!use_mmap_copy || mappings.empty() || use_direct_io) {
+        return;
+    }
+
+    map_addr.assign(files.size(), nullptr);
+    map_size.assign(files.size(), 0);
+    for (size_t i = 0; i < files.size() && i < mappings.size(); i++) {
+        if (mappings[i]) {
+            map_addr[i] = (const uint8_t *) mappings[i]->addr();
+            map_size[i] = mappings[i]->size();
+        }
+    }
+
+    const llama_moe_stream_weight * probe = nullptr;
+    for (const auto & sl : layers) {
+        if (sl && !sl->weights.empty()) {
+            probe = &sl->weights.front();
+            break;
+        }
+    }
+
+    bool ok = probe != nullptr && probe->file_idx < map_addr.size() && map_addr[probe->file_idx] != nullptr;
+    if (ok) {
+        const size_t len = std::min<size_t>(probe->nb_expert, 64*1024);
+        ok = probe->offs + len <= map_size[probe->file_idx];
+        if (ok) {
+            uint8_t * tmp = (uint8_t *) moe_aligned_alloc(len + 2*MOE_STREAM_DIRECT_ALIGN);
+            GGML_ASSERT(tmp != nullptr);
+            const uint8_t * via_read = llama_moe_stream_pread(*files[probe->file_idx], tmp, len, probe->offs, false);
+            ok = via_read != nullptr && memcmp(via_read, map_addr[probe->file_idx] + probe->offs, len) == 0;
+            moe_aligned_free(tmp);
+        }
+    }
+
+    if (!ok) {
+        LLAMA_LOG_WARN("%s: mapped slab does not match a read, uploading from staging instead\n", __func__);
+        map_addr.clear();
+        map_size.clear();
+    }
+
+    if (debug) {
+        fprintf(stderr, "moe stream: mmap upload %s\n", map_addr.empty() ? "off" : "on");
+        fflush(stderr);
+    }
+#endif
+}
