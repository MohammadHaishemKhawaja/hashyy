+        uint32_t hand = 0;
+        uint32_t used = 0;
+    };
+
+    std::mutex            mtx;
+    uint8_t *             arena       = nullptr;
+    ggml_backend_buffer_t pinned_buf  = nullptr; // non-null when the arena is pinned
+    size_t                arena_bytes = 0;
+    std::vector<pool> pools;
