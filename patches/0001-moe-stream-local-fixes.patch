+// Ranked expert ids per layer. Text so it can be inspected and hand-edited; it is tiny
+// (a few hundred KiB) and written once at shutdown.
+void llama_moe_stream::save_heat() const {
+    if (heat_path.empty()) {
+        return;
+    }
+    // write-then-rename: a kill partway through a save must not leave a truncated ranking
+    const std::string tmp = heat_path + ".tmp";
+    FILE * f = fopen(tmp.c_str(), "w");
+    if (f == nullptr) {
+        LLAMA_LOG_WARN("%s: cannot write expert heat to %s\n", __func__, tmp.c_str());
+        return;
+    }
+    fprintf(f, "moe_heat 2\n");
+
+    std::vector<int32_t> order;
+    for (size_t il = 0; il < layers.size(); il++) {
+        const auto & sl = layers[il];
+        if (!sl) {
+            continue;
+        }
+        order.resize(sl->n_expert);
+        for (uint32_t e = 0; e < sl->n_expert; e++) {
+            order[e] = (int32_t) e;
+        }
+        // ranked by the undecayed count: the warm order should be "most used", not "most
+        // recently used", and the decayed value drops rare-but-real experts to 0, which is
+        // what capped how deep a page-cache warm could go.
+        std::sort(order.begin(), order.end(), [&](int32_t a, int32_t b) {
+            if (sl->route_total[a] != sl->route_total[b]) {
+                return sl->route_total[a] > sl->route_total[b];
+            }
+            return sl->route_hotness[a] > sl->route_hotness[b];
+        });
+
+        size_t n = 0;
+        while (n < order.size() && sl->route_total[order[n]] > 0) {
+            n++;
+        }
+        fprintf(f, "L %zu %zu\n", il, n);
+        for (size_t i = 0; i < n; i++) {
+            fprintf(f, "%d %u %u\n", order[i], sl->route_hotness[order[i]], sl->route_total[order[i]]);
+        }
+    }
+    fclose(f);
+
+    std::remove(heat_path.c_str()); // rename does not replace on Windows
+    if (std::rename(tmp.c_str(), heat_path.c_str()) != 0) {
+        LLAMA_LOG_WARN("%s: cannot move %s into place\n", __func__, tmp.c_str());
+        return;
+    }
+    if (debug) {
+        fprintf(stderr, "moe stream: wrote expert heat to %s\n", heat_path.c_str());
+        fflush(stderr);
+    }
+}
