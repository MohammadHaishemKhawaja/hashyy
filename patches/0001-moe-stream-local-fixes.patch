+const uint8_t * llama_moe_stream::hot_lookup(uint16_t file_idx, size_t src_offs, size_t nb) const {
+    if (hot_base == nullptr) {
+        return nullptr;
+    }
+    const auto it = hot_index.find(((uint64_t) file_idx << 48) | (uint64_t) src_offs);
+    if (it == hot_index.end() || it->second + nb > hot_size) {
+        return nullptr;
+    }
+    return (const uint8_t *) hot_base + it->second;
+}
