+    }
+
+    // a pinned entry: the slab stays put until release(), so the caller can read into it and
+    // upload out of it with the lock dropped
+    struct ref_t {
+        uint8_t * ptr  = nullptr;
+        pool *    pl   = nullptr;
+        uint32_t  idx  = 0;
+        bool      fill = false; // true when the caller must still read the bytes in
+    };
+
+    // resident entry for key, or a reserved empty one to read into
+    ref_t acquire(uint64_t key, size_t len) {
+        ref_t r;
+        if (arena == nullptr) {
+            return r;
+        }
+        std::lock_guard<std::mutex> lk(mtx);
+        pool * pl = pool_for(len);
+        if (pl == nullptr) {
+            return r;
+        }
+
+        auto it = pl->map.find(key);
+        if (it != pl->map.end()) {
+            const uint32_t i = it->second;
+            if (!pl->valid[i]) {
+                return r; // someone else is still reading it, use the plain path
+            }
+            pl->ref[i] = 1;
+            pl->pin[i]++;
+            hits++;
+            return { pl->base + (size_t) i*pl->slab, pl, i, false };
+        }
+        misses++;
+
+        uint32_t idx;
+        if (pl->used < pl->n) {
+            idx = pl->used++;
+        } else {
+            // CLOCK: one second chance per entry, then take it
+            uint32_t guard = 0;
+            for (;; pl->hand = (pl->hand + 1) % pl->n) {
+                const uint32_t h = pl->hand;
+                if (pl->pin[h] == 0 && pl->valid[h]) {
+                    if (pl->ref[h] == 0) {
+                        idx = h;
+                        pl->hand = (h + 1) % pl->n;
+                        break;
+                    }
+                    pl->ref[h] = 0;
+                }
+                if (++guard > 4u*pl->n) {
+                    return r; // nothing evictable right now
+                }
+            }
+            pl->map.erase(pl->key[idx]);
+        }
+
+        pl->key[idx]   = key;
+        pl->valid[idx] = 0;
+        pl->ref[idx]   = 1;
+        pl->pin[idx]   = 1;
+        pl->map[key]   = idx;
+        return { pl->base + (size_t) idx*pl->slab, pl, idx, true };
+    }
+
+    // ok=false on a failed read: drop the reservation so the entry does not serve garbage
+    void release(const ref_t & r, bool ok) {
