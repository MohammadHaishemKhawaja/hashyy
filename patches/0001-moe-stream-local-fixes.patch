+            return;
+        }
+        std::lock_guard<std::mutex> lk(mtx);
+        if (r.fill) {
+            if (ok) {
+                r.pl->valid[r.idx] = 1;
+            } else {
+                r.pl->map.erase(r.pl->key[r.idx]);
+                r.pl->key[r.idx] = 0;
+            }
+        }
+        r.pl->pin[r.idx]--;
+    }
+
+    ~moe_l2_cache() {
+        if (arena) {
+            if (hits + misses) {
+                LLAMA_LOG_INFO("%s: MoE L2: %llu hits / %llu lookups (%.1f%%)\n", __func__,
+                        (unsigned long long) hits, (unsigned long long)(hits+misses),
