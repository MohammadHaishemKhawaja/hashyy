+void llama_moe_stream::open_hot_file() {
+    if (hot_path.empty()) {
+        return;
+    }
+#ifdef _WIN32
+    if (host_lock == nullptr) {
+        LLAMA_LOG_WARN("%s: backend cannot page-lock host memory, hot file disabled\n", __func__);
+        return;
+    }
+    const std::string ipath = hot_path + ".idx";
+    FILE * ix = fopen(ipath.c_str(), "r");
+    if (ix == nullptr) {
+        LLAMA_LOG_WARN("%s: no index at %s, hot file disabled\n", __func__, ipath.c_str());
+        return;
+    }
+    char magic[16] = {};
+    int  ver = 0;
+    long long n_slabs = 0;
+    if (fscanf(ix, "%15s %d %lld", magic, &ver, &n_slabs) != 3 ||
+            strcmp(magic, "moe_hot") != 0 || ver != 2) {
+        LLAMA_LOG_WARN("%s: %s is not a v2 hot index\n", __func__, ipath.c_str());
+        fclose(ix);
+        return;
+    }
+    hot_index.reserve((size_t) n_slabs*2);
+    for (long long k = 0; k < n_slabs; k++) {
+        long long fi = 0, src = 0, nb = 0, ho = 0;
+        if (fscanf(ix, " %lld %lld %lld %lld", &fi, &src, &nb, &ho) != 4) {
+            break;
+        }
+        hot_index[((uint64_t) (uint16_t) fi << 48) | (uint64_t) src] = (size_t) ho;
+    }
+    fclose(ix);
+
+    // READ-WRITE on purpose: a read-only mapping cannot be page-locked on this platform.
+    // Nothing ever writes through it.
+    HANDLE fh = CreateFileA(hot_path.c_str(), GENERIC_READ | GENERIC_WRITE,
+            FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
