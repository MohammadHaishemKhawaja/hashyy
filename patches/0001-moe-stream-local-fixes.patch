+// Heat-ranked host-RAM L2 for streamed expert slabs.
+//
+// The device cache (L1) is capped by VRAM. Without this, every L1 miss goes to
+// the GGUF file. On a consumer NVMe that is ~1.1 GB/s at expert granularity,
+// while a host->device copy runs at PCIe speed (~12 GB/s on gen3 x16), so an
+// L2 hit replaces a disk read with a copy an order of magnitude faster.
+//
+// The OS page cache is an accidental L2, but it evicts by LRU over every page
+// of the file (including the multi-GiB per-layer embedding table). This tier
+// holds expert slabs only and evicts the coldest by decaying access heat.
+//
+// Enable with LLAMA_MOE_STREAM_L2_GB=<n>. Disabled (0) by default.
+// Host-RAM L2 for streamed expert slabs, and the staging buffer at the same time.
+//
+// The tier only pays off if it adds no copy: a slab is read from the GGUF straight into its arena
+// entry, and uploaded to the device from there. An L2 hit is then one DMA out of host RAM, and an
+// L2 miss is one read plus that same DMA - exactly what the no-L2 path costs, so the arena is free
+// except for the RAM it takes from the OS page cache.
+//
+// Capacity is the whole game here, and an explicit tier can rank by route hotness where the page
+// cache only sees LRU over a 76 GiB file. Enable with LLAMA_MOE_STREAM_L2_GB=<n>, default off.
+struct moe_l2_cache {
+    struct pool {
+        size_t    slab = 0; // bytes per entry, rounded up for sector-aligned reads
+        size_t    len  = 0; // useful bytes
+        uint32_t  n    = 0;
+        uint8_t * base = nullptr;
+
+        std::vector<uint64_t> key;
+        std::vector<uint8_t>  valid; // 0 while a reservation is still being read
