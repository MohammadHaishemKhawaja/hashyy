+// Drains the upload queue onto this thread's CUDA stream and synchronizes once per drain,
+// then commits the slots. One sync per batch instead of one per slab is the difference
+// between 10.3 and 12.8 GB/s on this link, and because the copies no longer sit in the
+// middle of a worker's read loop they overlap the other workers' reads.
+void llama_moe_stream::uploader_loop() {
+    std::vector<llama_moe_stream_upload> batch;
+    std::unique_lock<std::mutex> lk(mtx);
+    while (true) {
+        cv_upload.wait(lk, [&]{ return shutting_down || !q_upload.empty(); });
+        if (shutting_down && q_upload.empty()) {
+            break;
+        }
+        batch.clear();
+        batch.reserve(q_upload.size());
+        while (!q_upload.empty()) {
+            batch.push_back(q_upload.front());
+            q_upload.pop_front();
+        }
+        lk.unlock();
+
+        const int64_t t0 = ggml_time_us();
+        for (const auto & u : batch) {
+            const auto & wt = u.sl->weights[u.widx];
+            const void * src = u.src != nullptr ? (const void *) u.src
+                                                : (const void *) (staging_base + (size_t) u.buf*staging_stride);
+            h2d_async(wt.cache, src, (size_t) u.slot*wt.nb_expert, wt.nb_expert);
+        }
+        h2d_sync();
+        const int64_t dt = ggml_time_us() - t0;
+
+        lk.lock();
+        stats.t_upload_us += dt;
+        for (const auto & u : batch) {
+            auto & sl = *u.sl;
+            const uint32_t bit = 1u << u.widx;
+            if (u.buf >= 0) {
+                staging_free.push_back(u.buf);
+            }
+            sl.slot_claimed[u.slot] &= ~bit;
+            // a reservation can have been superseded while the copy was in flight; the slab
+            // still landed in the right slot, but the slot no longer holds that expert
+            if (u.gen != sl.slot_gen[u.slot]) {
+                continue;
+            }
+            sl.slot_done[u.slot] |= bit;
+            if (sl.slot_done[u.slot] == sl.weights_mask()) {
+                sl.slot_state[u.slot] = LLAMA_MOE_STREAM_SLOT_RESIDENT;
+            }
+        }
+        cv_done.notify_all();
+        cv_upload.notify_all(); // workers may be waiting on a staging slab
+    }
