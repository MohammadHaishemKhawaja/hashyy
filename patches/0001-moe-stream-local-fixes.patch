+        return;
+    }
+    LARGE_INTEGER sz = {};
+    GetFileSizeEx(fh, &sz);
+    HANDLE mh = CreateFileMappingA(fh, nullptr, PAGE_READWRITE, 0, 0, nullptr);
+    if (mh == nullptr) {
+        CloseHandle(fh);
+        LLAMA_LOG_WARN("%s: CreateFileMapping failed (%lu), hot file disabled\n", __func__, GetLastError());
+        hot_index.clear();
+        return;
+    }
+    void * base = MapViewOfFile(mh, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, 0);
+    if (base == nullptr) {
+        CloseHandle(mh);
+        CloseHandle(fh);
+        LLAMA_LOG_WARN("%s: MapViewOfFile failed (%lu), hot file disabled\n", __func__, GetLastError());
