+// Fill every device slot with the hottest experts from a previous run, then optionally read
+// further down the ranking so those slabs land in the OS page cache too.
+void llama_moe_stream::warm_from_heat() {
+    FILE * f = fopen(heat_path.c_str(), "r");
+    if (f == nullptr) {
+        if (debug) {
+            fprintf(stderr, "moe stream: no heat file at %s, starting cold\n", heat_path.c_str());
+            fflush(stderr);
+        }
+        return;
+    }
+
+    char magic[32] = {};
+    int  version   = 0;
+    if (fscanf(f, "%31s %d", magic, &version) != 2 || strcmp(magic, "moe_heat") != 0 ||
+            (version != 1 && version != 2)) {
+        LLAMA_LOG_WARN("%s: %s is not a v1/v2 heat file\n", __func__, heat_path.c_str());
+        fclose(f);
+        return;
+    }
+
+    struct heat_entry { int32_t e; uint32_t h; uint32_t tot; };
+    std::vector<std::vector<heat_entry>> ranked(layers.size());
+    size_t il = 0, n = 0;
+    while (fscanf(f, " L %zu %zu", &il, &n) == 2) {
+        if (il >= layers.size()) {
+            break;
+        }
+        ranked[il].reserve(n);
+        for (size_t i = 0; i < n; i++) {
+            int32_t  e = -1;
+            uint32_t h = 0, tot = 0;
+            if (fscanf(f, " %d %u", &e, &h) != 2) {
+                break;
+            }
+            if (version >= 2 && fscanf(f, " %u", &tot) != 1) {
+                break;
+            }
+            // seed eviction with something non-zero even where the decayed heat aged
+            // out, or the warm set is evicted again within ~30 tokens
+            if (h == 0 && tot > 0) {
+                h = 1;
+            }
+            if (e >= 0) {
+                ranked[il].push_back({ e, h, tot > 0 ? tot : h });
+            }
+        }
+    }
+    fclose(f);
+
+    const int64_t t0 = ggml_time_us();
+    size_t n_slots_filled = 0;
+    {
+        std::unique_lock<std::mutex> lk(mtx);
+        start_workers_locked();
+        for (size_t i = 0; i < layers.size(); i++) {
+            auto & sl = layers[i];
+            if (!sl || ranked[i].empty()) {
+                continue;
+            }
+            // eviction ranks by route_hotness first, so a cache warmed without it would be
+            // thrown away by the first few misses
+            for (const auto & r : ranked[i]) {
+                if ((uint32_t) r.e < sl->n_expert) {
+                    sl->route_hotness[r.e] = r.h;
+                    // also the undecayed count, so the page-cache admission band treats a
+                    // warmed expert as known rather than as a first-ever touch
+                    sl->route_total[r.e] = r.tot;
+                }
+            }
+
+            const size_t want = std::min<size_t>(ranked[i].size(), sl->n_slots);
+            for (size_t k = want; k-- > 0; ) {
+                const int32_t e = ranked[i][k].e;
+                if ((uint32_t) e >= sl->n_expert || sl->expert_slot.count(e)) {
+                    continue;
+                }
+                const int32_t slot = (int32_t) k;
+                reserve_slot_locked(*sl, e, slot);
+                enqueue_weights_locked(*sl, e, slot);
+                n_slots_filled++;
+            }
+        }
+        // the graph has not run yet, so nothing can be evicted out from under us
+        cv_done.wait(lk, [&]{
+            if (load_failed) {
+                return true;
+            }
+            for (const auto & sl : layers) {
+                if (!sl) {
+                    continue;
+                }
+                for (uint32_t s = 0; s < sl->n_slots; s++) {
+                    if (sl->slot_state[s] == LLAMA_MOE_STREAM_SLOT_LOADING) {
+                        return false;
+                    }
+                }
