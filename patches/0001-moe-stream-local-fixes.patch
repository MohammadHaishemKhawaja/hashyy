+        // hotness has aged out is still in the page cache, and reading it unbuffered would
+        // go to disk for bytes that are already in RAM
+        q_demand.push_back({ &sl, expert, slot, split_weights ? i : -1, sl.slot_gen[slot], sl.route_total[expert] });
+        cv_work.notify_one();
+    }
