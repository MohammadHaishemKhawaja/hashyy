+            arena_bytes = 0;
+            return;
+        }
+
+        uint8_t * p = arena;
+        pools.resize(sizes.size());
+        for (size_t i = 0; i < sizes.size(); i++) {
+            auto & pl = pools[i];
+            pl.len  = sizes[i];
+            pl.slab = align_up(sizes[i], MOE_STREAM_DIRECT_ALIGN);
+            pl.n    = (uint32_t) n_entries;
+            pl.base = p;
+            p      += (size_t) n_entries * pl.slab;
+            pl.key  .assign(n_entries, 0);
+            pl.valid.assign(n_entries, 0);
+            pl.ref  .assign(n_entries, 0);
+            pl.pin  .assign(n_entries, 0);
+            pl.map.reserve(n_entries * 2);
+        }
+
+        LLAMA_LOG_INFO("%s: MoE L2 host cache: %.2f GiB, %zu experts\n",
+                __func__, (double) arena_bytes/(1024.0*1024.0*1024.0), n_entries);
+        fprintf(stderr, "moe stream: L2 host cache %.2f GiB, %zu experts, %zu pools, %s\n",
+                (double) arena_bytes/(1024.0*1024.0*1024.0), n_entries, pools.size(),
+                pinned_buf != nullptr ? "pinned (uploads DMA from the arena)" : "pageable");
+        fflush(stderr);
+    }
+
+    bool enabled()   const { return arena != nullptr; }
+    bool is_pinned() const { return pinned_buf != nullptr; }
+
+    pool * pool_for(size_t len) {
