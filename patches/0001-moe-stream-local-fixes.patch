+// one queue item per weight of the expert, so they load concurrently
+void llama_moe_stream::enqueue_weights_locked(llama_moe_stream_layer & sl, int32_t expert, int32_t slot) {
+    const int32_t n = split_weights ? (int32_t) sl.weights.size() : 1;
+    for (int32_t i = 0; i < n; i++) {
