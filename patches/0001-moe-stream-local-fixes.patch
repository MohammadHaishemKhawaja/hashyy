+// Page-lock a host range that is NOT read-only, for the MoE expert stream's hot-expert file.
+//
+// ggml_backend_cuda_register_host_buffer asks for cudaHostRegisterReadOnly, which this box
+// does not support (cudaDevAttrHostRegisterReadOnlySupported = 0 under Windows WDDM), so a
+// read-only GGUF mapping can never be registered. A mapping opened read-write can:
+// plain registration is supported here, and DMA out of a registered 12 GiB file mapping
+// measured 9.6-11.7 GB/s against the 12.8 GB/s link ceiling, with no CPU copy at all
+// (scratchpad/pinmap.cu). That removes two of the three passes over DRAM that every
+// page-cache hit otherwise costs: ReadFile's memcpy in, and the DMA's read back out.
+static bool ggml_backend_cuda_host_lock(void * buffer, size_t size) {
+    cudaError_t err = cudaHostRegister(buffer, size, cudaHostRegisterDefault);
+    if (err != cudaSuccess) {
+        (void) cudaGetLastError();
+        return false;
+    }
+    return true;
+}
+
+static void ggml_backend_cuda_host_unlock(void * buffer) {
+    (void) cudaHostUnregister(buffer);
+    (void) cudaGetLastError();
+}
+
+// Thread-private H2D upload, used by the MoE expert stream's uploader thread.
+//
+// ggml_backend_tensor_set synchronizes the stream after every copy. For the expert stream that
+// is one sync per 512-900 KiB slab, which measured 10.3 GB/s against 12.8 GB/s for the same
+// transfers with one sync per batch (scratchpad/h2d.cu), and it also stops the copy from
+// overlapping the next read. These two split the issue from the wait so the caller can batch.
+// Both use cudaStreamPerThread, so they are safe from any one thread and must be paired on
+// that same thread.
+static void ggml_backend_cuda_h2d_async(ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
+    ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    ggml_backend_cuda_buffer_context * ctx = (ggml_backend_cuda_buffer_context *) buf->context;
+    ggml_cuda_set_device(ctx->device);
+    CUDA_CHECK(cudaMemcpyAsync((char *) tensor->data + offset, data, size, cudaMemcpyHostToDevice, cudaStreamPerThread));
+}
+
+static void ggml_backend_cuda_h2d_sync(void) {
+    CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+}
