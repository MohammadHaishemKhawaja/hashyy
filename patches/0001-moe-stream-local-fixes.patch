+        return;
+    }
+    hot_base   = base;
+    hot_size   = (size_t) sz.QuadPart;
+    hot_file   = fh;
+    hot_map    = mh;
+    hot_locked = true;
+    LLAMA_LOG_INFO("%s: hot expert file %.2f GiB, %zu experts, paged in %.1fs, locked in %.1fs\n",
+            __func__, hot_size/1073741824.0, hot_index.size(), t_touch, (ggml_time_us() - t1)/1e6);
