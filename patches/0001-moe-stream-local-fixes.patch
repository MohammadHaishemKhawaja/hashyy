+ggml_backend_buffer_type_t llama_moe_stream::pinned_buft() const {
+    for (const auto & [buft, ctx] : ctxs) {
+        ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+        if (dev == nullptr) {
+            continue;
+        }
+        if (auto * hb = ggml_backend_dev_host_buffer_type(dev)) {
+            return hb;
+        }
+    }
+    return nullptr;
+}
