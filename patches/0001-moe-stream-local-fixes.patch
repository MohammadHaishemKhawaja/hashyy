+            return;
+        }
+
+        // budget whole experts: an expert is only useful with all of its weights resident
+        size_t per_expert = 0;
+        for (size_t s : sizes) {
+            per_expert += align_up(s, MOE_STREAM_DIRECT_ALIGN);
+        }
+        if (per_expert == 0) {
+            return;
+        }
+
+        const size_t n_entries = (size_t) (gb * 1024.0*1024.0*1024.0) / per_expert;
+        if (n_entries == 0) {
+            return;
+        }
+
+        arena_bytes = n_entries * per_expert;
